# pdf_generator.py — Pennyfarthing Perfect Delivery PDF generator
# Uses ReportLab to produce branded submission records

import io
import os
from datetime import datetime

try:
    from reportlab.lib import colors
    from reportlab.lib.pagesizes import A4
    from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
    from reportlab.lib.units import mm
    from reportlab.platypus import (
        SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle,
        HRFlowable, Image as RLImage, KeepTogether
    )
    from reportlab.lib.enums import TA_LEFT, TA_CENTER, TA_RIGHT
    REPORTLAB_AVAILABLE = True
except ImportError:
    REPORTLAB_AVAILABLE = False

try:
    import requests
    REQUESTS_AVAILABLE = True
except ImportError:
    REQUESTS_AVAILABLE = False


def _hex_to_color(hex_str):
    """Convert hex colour to ReportLab color."""
    hex_str = hex_str.lstrip('#')
    r, g, b = int(hex_str[0:2], 16), int(hex_str[2:4], 16), int(hex_str[4:6], 16)
    return colors.Color(r/255, g/255, b/255)


def _fetch_image_bytes(url: str) -> bytes | None:
    """Fetch image from URL, return bytes or None."""
    if not REQUESTS_AVAILABLE or not url:
        return None
    try:
        r = requests.get(url, timeout=10)
        if r.status_code == 200:
            return r.content
    except Exception as e:
        print(f"Image fetch error {url}: {e}")
    return None


def generate_submission_pdf(
    submission: dict,
    plot: dict,
    site: dict,
    stage_items: list,
    photos_by_item: dict,
    tenant: dict = None,
) -> bytes:
    """
    Generate a branded PDF for a completed PD submission.
    Returns PDF bytes.
    """
    if not REPORTLAB_AVAILABLE:
        raise RuntimeError("ReportLab not installed. Add 'reportlab' to requirements.txt")

    # Branding
    tenant = tenant or {}
    company_name    = tenant.get("name", "Pennyfarthing Homes")
    company_address = tenant.get("address", "")
    company_phone   = tenant.get("phone", "")
    company_email   = tenant.get("email", "")
    logo_url        = tenant.get("logo_url", "")
    primary_hex     = tenant.get("primary_color", "#1a1a2e")
    secondary_hex   = tenant.get("secondary_color", "#C5962A")

    PRIMARY   = _hex_to_color(primary_hex)
    SECONDARY = _hex_to_color(secondary_hex)
    WHITE     = colors.white
    LIGHT_GREY = colors.Color(0.95, 0.95, 0.95)
    MID_GREY   = colors.Color(0.7, 0.7, 0.7)
    YES_GREEN  = colors.Color(0.086, 0.639, 0.29)
    NO_RED     = colors.Color(0.863, 0.149, 0.149)
    NA_GREY    = colors.Color(0.42, 0.447, 0.475)
    SKIP_AMBER = colors.Color(0.855, 0.647, 0.125)

    buf = io.BytesIO()
    doc = SimpleDocTemplate(
        buf, pagesize=A4,
        leftMargin=15*mm, rightMargin=15*mm,
        topMargin=15*mm, bottomMargin=15*mm,
    )

    W = A4[0] - 30*mm  # usable width

    styles = getSampleStyleSheet()
    def style(name, **kw):
        s = ParagraphStyle(name, parent=styles['Normal'], **kw)
        return s

    s_body    = style('body',    fontSize=9,  leading=13, textColor=colors.Color(0.2,0.2,0.2))
    s_small   = style('small',   fontSize=7.5, leading=11, textColor=colors.Color(0.4,0.4,0.4))
    s_bold    = style('bold',    fontSize=9,  leading=13, textColor=colors.Color(0.1,0.1,0.1), fontName='Helvetica-Bold')
    s_heading = style('heading', fontSize=11, leading=15, textColor=PRIMARY, fontName='Helvetica-Bold')
    s_center  = style('center',  fontSize=8,  leading=12, alignment=TA_CENTER, textColor=colors.Color(0.3,0.3,0.3))

    story = []

    # ── Header bar ──────────────────────────────────────────────────────────
    # Logo + company info + document title
    logo_cell = ''
    if logo_url:
        img_bytes = _fetch_image_bytes(logo_url)
        if img_bytes:
            try:
                logo_img = RLImage(io.BytesIO(img_bytes), width=35*mm, height=18*mm, kind='bound')
                logo_cell = logo_img
            except Exception:
                logo_cell = Paragraph(company_name, style('logotext', fontSize=14, fontName='Helvetica-Bold', textColor=WHITE))
        else:
            logo_cell = Paragraph(company_name, style('logotext', fontSize=13, fontName='Helvetica-Bold', textColor=WHITE))
    else:
        logo_cell = Paragraph(company_name, style('logotext', fontSize=13, fontName='Helvetica-Bold', textColor=WHITE))

    doc_title_para = Paragraph(
        'PERFECT DELIVERY<br/>STAGE SIGN-OFF',
        style('doctitle', fontSize=14, fontName='Helvetica-Bold', textColor=SECONDARY, alignment=TA_RIGHT, leading=18)
    )

    header_table = Table(
        [[logo_cell, doc_title_para]],
        colWidths=[W*0.5, W*0.5],
    )
    header_table.setStyle(TableStyle([
        ('BACKGROUND',  (0,0), (-1,-1), PRIMARY),
        ('VALIGN',      (0,0), (-1,-1), 'MIDDLE'),
        ('LEFTPADDING', (0,0), (0,0),   8),
        ('RIGHTPADDING',(-1,0),(-1,0),  8),
        ('TOPPADDING',  (0,0), (-1,-1), 8),
        ('BOTTOMPADDING',(0,0),(-1,-1), 8),
    ]))
    story.append(header_table)

    # ── Submission meta ──────────────────────────────────────────────────────
    story.append(Spacer(1, 4*mm))

    sub_date = str(submission.get("submitted_at", ""))[:16].replace("T", " ")
    rev_date = str(submission.get("reviewed_at", ""))[:16].replace("T", " ") if submission.get("reviewed_at") else "—"
    status   = submission.get("status", "pending").upper()
    status_color = YES_GREEN if status == "APPROVED" else (NO_RED if status == "REJECTED" else SKIP_AMBER)

    meta_data = [
        [
            Paragraph('<b>Site</b>', s_bold),
            Paragraph(site.get("name", ""), s_body),
            Paragraph('<b>Plot</b>', s_bold),
            Paragraph(plot.get("plot_number", ""), s_body),
        ],
        [
            Paragraph('<b>Stage</b>', s_bold),
            Paragraph(submission.get("stage_name", ""), s_body),
            Paragraph('<b>Submitted</b>', s_bold),
            Paragraph(sub_date, s_body),
        ],
        [
            Paragraph('<b>Subcontractor</b>', s_bold),
            Paragraph(submission.get("submitted_by_name", ""), s_body),
            Paragraph('<b>Company</b>', s_bold),
            Paragraph(submission.get("submitted_by_company", ""), s_body),
        ],
        [
            Paragraph('<b>Reviewed by</b>', s_bold),
            Paragraph(submission.get("reviewed_by", "—"), s_body),
            Paragraph('<b>Review date</b>', s_bold),
            Paragraph(rev_date, s_body),
        ],
    ]

    meta_table = Table(meta_data, colWidths=[W*0.18, W*0.32, W*0.18, W*0.32])
    meta_table.setStyle(TableStyle([
        ('BACKGROUND',    (0,0), (-1,-1), LIGHT_GREY),
        ('GRID',          (0,0), (-1,-1), 0.5, MID_GREY),
        ('LEFTPADDING',   (0,0), (-1,-1), 6),
        ('RIGHTPADDING',  (0,0), (-1,-1), 6),
        ('TOPPADDING',    (0,0), (-1,-1), 4),
        ('BOTTOMPADDING', (0,0), (-1,-1), 4),
        ('VALIGN',        (0,0), (-1,-1), 'TOP'),
    ]))
    story.append(meta_table)

    # Status badge
    story.append(Spacer(1, 3*mm))
    status_text = {
        "APPROVED": "✓  APPROVED — Payment can be progressed for this stage",
        "REJECTED": "✗  REJECTED — See manager notes below",
        "PENDING":  "⏳  AWAITING REVIEW",
    }.get(status, status)

    status_table = Table(
        [[Paragraph(status_text, style('st', fontSize=10, fontName='Helvetica-Bold', textColor=WHITE, alignment=TA_CENTER))]],
        colWidths=[W],
    )
    status_table.setStyle(TableStyle([
        ('BACKGROUND',    (0,0), (-1,-1), status_color),
        ('TOPPADDING',    (0,0), (-1,-1), 6),
        ('BOTTOMPADDING', (0,0), (-1,-1), 6),
        ('ROUNDEDCORNERS', [4]),
    ]))
    story.append(status_table)

    # Manager notes
    if submission.get("manager_notes"):
        story.append(Spacer(1, 3*mm))
        notes_table = Table(
            [[
                Paragraph('<b>Site Manager Notes:</b>', s_bold),
                Paragraph(submission["manager_notes"], s_body),
            ]],
            colWidths=[W*0.22, W*0.78],
        )
        notes_table.setStyle(TableStyle([
            ('BACKGROUND',    (0,0), (-1,-1), colors.Color(1, 0.98, 0.88)),
            ('GRID',          (0,0), (-1,-1), 0.5, colors.Color(0.9, 0.8, 0.4)),
            ('LEFTPADDING',   (0,0), (-1,-1), 6),
            ('RIGHTPADDING',  (0,0), (-1,-1), 6),
            ('TOPPADDING',    (0,0), (-1,-1), 5),
            ('BOTTOMPADDING', (0,0), (-1,-1), 5),
            ('VALIGN',        (0,0), (-1,-1), 'TOP'),
        ]))
        story.append(notes_table)

    # Additional notes
    if submission.get("additional_notes"):
        story.append(Spacer(1, 2*mm))
        anotes_table = Table(
            [[
                Paragraph('<b>Subcontractor Notes:</b>', s_bold),
                Paragraph(submission["additional_notes"], s_body),
            ]],
            colWidths=[W*0.22, W*0.78],
        )
        anotes_table.setStyle(TableStyle([
            ('BACKGROUND',    (0,0), (-1,-1), colors.Color(0.94, 0.97, 1.0)),
            ('GRID',          (0,0), (-1,-1), 0.5, MID_GREY),
            ('LEFTPADDING',   (0,0), (-1,-1), 6),
            ('RIGHTPADDING',  (0,0), (-1,-1), 6),
            ('TOPPADDING',    (0,0), (-1,-1), 5),
            ('BOTTOMPADDING', (0,0), (-1,-1), 5),
            ('VALIGN',        (0,0), (-1,-1), 'TOP'),
        ]))
        story.append(anotes_table)

    # ── Checklist answers ────────────────────────────────────────────────────
    story.append(Spacer(1, 5*mm))
    story.append(Paragraph("Checklist Answers", s_heading))
    story.append(Spacer(1, 2*mm))

    answers = submission.get("answers", {}) or {}

    # Stats row
    yes_count = sum(1 for a in answers.values() if isinstance(a, dict) and a.get("value") == "yes")
    no_count  = sum(1 for a in answers.values() if isinstance(a, dict) and a.get("value") == "no")
    na_count  = sum(1 for a in answers.values() if isinstance(a, dict) and a.get("value") == "n/a")
    un_count  = len(stage_items) - yes_count - no_count - na_count

    stats_data = [[
        Paragraph(f'<b>{yes_count}</b><br/>Yes', style('sc', fontSize=9, alignment=TA_CENTER, textColor=YES_GREEN)),
        Paragraph(f'<b>{no_count}</b><br/>No',  style('sc2', fontSize=9, alignment=TA_CENTER, textColor=NO_RED)),
        Paragraph(f'<b>{na_count}</b><br/>N/A', style('sc3', fontSize=9, alignment=TA_CENTER, textColor=NA_GREY)),
        Paragraph(f'<b>{un_count}</b><br/>Skipped', style('sc4', fontSize=9, alignment=TA_CENTER, textColor=SKIP_AMBER)),
        Paragraph(f'<b>{len(stage_items)}</b><br/>Total', style('sc5', fontSize=9, alignment=TA_CENTER, textColor=PRIMARY)),
    ]]
    stats_table = Table(stats_data, colWidths=[W/5]*5)
    stats_table.setStyle(TableStyle([
        ('BACKGROUND',    (0,0), (-1,-1), LIGHT_GREY),
        ('GRID',          (0,0), (-1,-1), 0.5, MID_GREY),
        ('TOPPADDING',    (0,0), (-1,-1), 5),
        ('BOTTOMPADDING', (0,0), (-1,-1), 5),
    ]))
    story.append(stats_table)
    story.append(Spacer(1, 3*mm))

    # Item rows
    for idx, item in enumerate(stage_items, 1):
        item_id = item.get("id", "")
        item_text = item.get("text", "")
        answer_data = answers.get(item_id, {}) or {}
        val = answer_data.get("value", "") if isinstance(answer_data, dict) else ""
        confirmed_text = answer_data.get("text", "") if isinstance(answer_data, dict) else ""

        # Answer badge colour
        if val == "yes":
            badge_bg, badge_fg, badge_txt = YES_GREEN, WHITE, "✓  YES"
        elif val == "no":
            badge_bg, badge_fg, badge_txt = NO_RED, WHITE, "✗  NO"
        elif val == "n/a":
            badge_bg, badge_fg, badge_txt = NA_GREY, WHITE, "—  N/A"
        else:
            badge_bg, badge_fg, badge_txt = SKIP_AMBER, WHITE, "SKIPPED"

        item_para = Paragraph(f'<b>{idx:02d}.</b> {item_text}', s_body)
        badge_para = Paragraph(badge_txt, style(
            f'badge_{idx}', fontSize=8, fontName='Helvetica-Bold',
            textColor=badge_fg, alignment=TA_CENTER
        ))

        row_data = [[item_para, badge_para]]
        row_table = Table(row_data, colWidths=[W*0.80, W*0.20])
        row_table.setStyle(TableStyle([
            ('BACKGROUND',    (0,0), (0,0), colors.Color(0.98, 0.98, 0.98) if idx % 2 == 0 else WHITE),
            ('BACKGROUND',    (1,0), (1,0), badge_bg),
            ('GRID',          (0,0), (-1,-1), 0.3, MID_GREY),
            ('LEFTPADDING',   (0,0), (-1,-1), 5),
            ('RIGHTPADDING',  (0,0), (-1,-1), 5),
            ('TOPPADDING',    (0,0), (-1,-1), 4),
            ('BOTTOMPADDING', (0,0), (-1,-1), 4),
            ('VALIGN',        (0,0), (-1,-1), 'TOP'),
        ]))

        item_elements = [row_table]

        if confirmed_text:
            conf_table = Table(
                [[Paragraph(f'Confirmed: {confirmed_text}', s_small)]],
                colWidths=[W],
            )
            conf_table.setStyle(TableStyle([
                ('BACKGROUND',    (0,0), (-1,-1), colors.Color(0.94, 0.97, 1.0)),
                ('LEFTPADDING',   (0,0), (-1,-1), 5),
                ('TOPPADDING',    (0,0), (-1,-1), 2),
                ('BOTTOMPADDING', (0,0), (-1,-1), 2),
            ]))
            item_elements.append(conf_table)

        # Photos for this item
        item_photos = photos_by_item.get(item_id, [])
        if item_photos:
            photo_imgs = []
            for url in item_photos[:4]:  # max 4 photos per item
                img_bytes = _fetch_image_bytes(url)
                if img_bytes:
                    try:
                        photo_imgs.append(RLImage(io.BytesIO(img_bytes), width=38*mm, height=30*mm, kind='bound'))
                    except Exception:
                        pass

            if photo_imgs:
                # Fill to 4 cols
                while len(photo_imgs) < 4:
                    photo_imgs.append('')
                photo_table = Table([photo_imgs], colWidths=[W/4]*4)
                photo_table.setStyle(TableStyle([
                    ('LEFTPADDING',   (0,0), (-1,-1), 2),
                    ('RIGHTPADDING',  (0,0), (-1,-1), 2),
                    ('TOPPADDING',    (0,0), (-1,-1), 3),
                    ('BOTTOMPADDING', (0,0), (-1,-1), 3),
                    ('ALIGN',         (0,0), (-1,-1), 'CENTER'),
                    ('VALIGN',        (0,0), (-1,-1), 'MIDDLE'),
                    ('BACKGROUND',    (0,0), (-1,-1), LIGHT_GREY),
                ]))
                item_elements.append(photo_table)

        story.append(KeepTogether(item_elements))
        story.append(Spacer(1, 1*mm))

    # ── Footer ───────────────────────────────────────────────────────────────
    story.append(Spacer(1, 6*mm))
    story.append(HRFlowable(width=W, thickness=1, color=SECONDARY))
    story.append(Spacer(1, 2*mm))

    footer_text = f'{company_name}'
    if company_address:
        footer_text += f' · {company_address}'
    if company_phone:
        footer_text += f' · {company_phone}'
    footer_text += f' · Generated {datetime.now().strftime("%d %b %Y %H:%M")}'

    story.append(Paragraph(footer_text, style(
        'footer', fontSize=7, textColor=MID_GREY, alignment=TA_CENTER
    )))

    doc.build(story)
    return buf.getvalue()
